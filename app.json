{
  "expo": {
    "name": "Bump Match",
    "slug": "bump-match",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sherbetagency.bumpmatch",
      "icon": "./assets/icon-ios.png",
      "buildNumber": "16",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Allow tracking so we can see which ads brought you to Bump Match and reach more parents-to-be like you. We never sell your data or share your baby names."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FA92A9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.orbitai.bumpmatch",
      "googleServicesFile": "./google-services.json",
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9f0dd1ac-0f6e-436d-999c-e002e06ba3bf"
      }
    },
    "owner": "elien7",
    "scheme": "bumpmatch",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FA92A9"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FEFAF6"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1094018189789929",
          "clientToken": "f026678a30c88197f9b33426243c56cc",
          "displayName": "Bump Match",
          "scheme": "fb1094018189789929",
          "isAutoInitEnabled": false,
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": "Allow tracking so we can see which ads brought you to Bump Match and reach more parents-to-be like you. We never sell your data or share your baby names."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow tracking so we can see which ads brought you to Bump Match and reach more parents-to-be like you. We never sell your data or share your baby names."
        }
      ]
    ]
  }
}
